{
  "name": "llm-mimic-surface",
  "version": "0.1.0",
  "description": "External API Interface layer: expose a user-supplied backend through familiar AI protocol adapters.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llm-mimic-surface": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taiyop/llm-mimic-surface.git"
  },
  "bugs": {
    "url": "https://github.com/taiyop/llm-mimic-surface/issues"
  },
  "homepage": "https://github.com/taiyop/llm-mimic-surface#readme",
  "keywords": [
    "openai-compatible",
    "anthropic-compatible",
    "gemini-compatible",
    "xai",
    "grok",
    "protocol-adapter",
    "external-api",
    "sse",
    "llm"
  ],
  "dependencies": {
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "openai": "^5.16.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
